     config.text_config.dtype = torch.bfloat16
     
-    # Initialize the multimodal LLM (Qwen3VL) with Flash Attention 2 for efficiency
-    model = Qwen3VLForConditionalGeneration.from_pretrained(args.model_path, config=config, dtype=torch.float16, device_map="auto", attn_implementation="flash_attention_2")
+    # Initialize the multimodal LLM (Qwen3VL). The attention backend is selectable:
+    # flash_attn needs a wheel matching the exact torch/CPython/CUDA triple, and
+    # building it from source takes ~30 min, so a whole pipeline run should not
+    # hinge on it. Set SIMART_ATTN_IMPL=flash_attention_2 to restore the original.
+    _attn_impl = os.environ.get("SIMART_ATTN_IMPL", "sdpa")
+    print(f"[simart] attn_implementation={_attn_impl}")
+    model = Qwen3VLForConditionalGeneration.from_pretrained(args.model_path, config=config, dtype=torch.float16, device_map="auto", attn_implementation=_attn_impl)
     
     # Load processor and tokenizer for text/image inputs
     processor = AutoProcessor.from_pretrained(args.model_path)
@@ -318,6 +323,14 @@ def main():
         inputs = processor(text=[text], images=image_inputs, padding=True, return_tensors="pt").to(device)
 
         gen_kwargs = {"max_new_tokens": args.max_new_tokens, **inputs}
+        # The checkpoint's generation_config has do_sample=True / temperature=0.7,
+        # so unseeded runs are not reproducible. SIMART_SEED pins the sampler
+        # (offset by an object counter so a folder run still varies per object);
+        # leaving it unset keeps upstream behaviour.
+        if os.environ.get("SIMART_SEED"):
+            _n = getattr(main, "_gen_count", 0)
+            main._gen_count = _n + 1
+            torch.manual_seed(int(os.environ["SIMART_SEED"]) + _n)
         generated_ids = model.generate(**gen_kwargs)
         response_ids = generated_ids[0][len(inputs.input_ids[0]):]
         response = tokenizer.decode(response_ids, skip_special_tokens=True)
@@ -326,7 +339,20 @@ def main():
         pred_caps = parse_parts_captions_json(response)
 
